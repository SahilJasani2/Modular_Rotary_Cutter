<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MainMachine" Id="{7d03d295-f101-4685-8cbf-a1d2f35ed8c9}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MainMachine
VAR_INPUT
    // --- Operator Commands ---
    {attribute 'OPC.UA.DA' := '1'}
    bCmdStart       : BOOL;
    
    {attribute 'OPC.UA.DA' := '1'}
    bCmdStop        : BOOL;
    
    {attribute 'OPC.UA.DA' := '1'}
    bCmdReset       : BOOL;
END_VAR

VAR_OUTPUT
    // --- State Machine Tracking ---
    {attribute 'OPC.UA.DA' := '1'}
    eState          : E_MachineState := E_MachineState.STOPPED;
    
    {attribute 'OPC.UA.DA' := '1'}
    udiCutsCompleted : UDINT;
END_VAR

VAR
    // --- The Physical Modules (Private) ---
    InfeedConveyor  : FB_InfeedConveyor;
    RotaryKnife     : FB_RotaryKnife;
    
    // --- The Virtual Motors (Private) ---
    ConveyorMotor   : FB_Drive;
    KnifeMotor      : FB_Drive;

    // --- Concrete Hardware Instances for Simulation (Private) ---
    fbProductSensor : FB_DigitalSensor;
    
    // --- Edge/IoT Telemetry (Private) ---
    EdgeGateway     : FB_Telemetry;
    
    // --- Industrial Diagnostics (Alarms) (Private) ---
    fbEventLogger      : FB_TcEventLogger;
    fbAlarmJam         : FB_TcAlarm;      // Alarm for material jams
    fbAlarmSafety      : FB_TcAlarm;      // Alarm for E-Stop / Safety Trips
    bAlarmsInitialized : BOOL;            // Flag to run setup code only once
    tonSensorJam       : TON;             // Detects if material is stuck
    
    // --- Safety Interface (Private) ---
    bSafetyOk          : BOOL;            // Locally mapped safety signal
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =========================================================
// 0. SAFETY MONITORING
// =========================================================
bSafetyOk := GVL_Safety.bSafetyOk;

// If safety drops, force the state machine into the ABORT sequence immediately.
IF NOT bSafetyOk AND eState <> E_MachineState.ABORTING AND eState <> E_MachineState.ABORTED THEN
    eState := E_MachineState.ABORTING;
END_IF

// =========================================================
// 1. HARDWARE LINKING
// =========================================================
fbProductSensor.bSimulationMode := TRUE;
InfeedConveyor.iProductCam := fbProductSensor;
InfeedConveyor.iMotor      := ConveyorMotor;
RotaryKnife.iMotor         := KnifeMotor;

// =========================================================
// 2. THE PACKML STATE MACHINE
// =========================================================
CASE eState OF

    E_MachineState.UNDEFINED:
        eState := E_MachineState.STOPPED;

    // ---------------------------------------------------------
    // NORMAL OPERATIONS
    // ---------------------------------------------------------
    E_MachineState.STOPPED:
        IF bCmdStart AND bSafetyOk THEN
            bCmdStart := FALSE;
            eState := E_MachineState.STARTING;
        END_IF

    E_MachineState.STARTING:
        // Trigger the homing routine we built in Phase 1
        RotaryKnife.bHomeCommand := TRUE;
        
        // PHASE 2 FIX: Wait for homing to finish AND ensure no NC errors
        IF NOT RotaryKnife.iMotor.P_Busy AND NOT RotaryKnife.iMotor.P_Error THEN 
            RotaryKnife.bHomeCommand := FALSE;
            eState := E_MachineState.EXECUTE;
            
            // --- NEW: Print to console when machine starts ---
            ADSLOGSTR(msgCtrlMask := ADSLOG_MSGTYPE_HINT, msgFmtStr := '>>> MACHINE STARTED: Reached EXECUTE State <<<', strArg := '');
        END_IF

	E_MachineState.EXECUTE:
        RotaryKnife.bEnable := TRUE;
        InfeedConveyor.bEnable := TRUE; 

        // Ninja Chop Logic (Now with real NC Physics!)
        IF fbProductSensor.P_RisingEdge THEN
            RotaryKnife.bEngageGearing := TRUE; 
            RotaryKnife.bSyncCommand   := TRUE; 
            ADSLOGSTR(msgCtrlMask := ADSLOG_MSGTYPE_HINT, msgFmtStr := '>>> C++ HANDSHAKE OK: Product Detected! <<<', strArg := '');
        END_IF
        
        IF fbProductSensor.P_FallingEdge THEN
            RotaryKnife.bEngageGearing := FALSE; 
            RotaryKnife.bSyncCommand   := FALSE; 
            udiCutsCompleted := udiCutsCompleted + 1;
        END_IF
        
        IF bCmdStop THEN
            bCmdStop := FALSE;
            eState := E_MachineState.HOLDING;
        END_IF
		
    // ---------------------------------------------------------
    // PAUSING (Non-critical stops)
    // ---------------------------------------------------------
    E_MachineState.HOLDING:
        RotaryKnife.bSyncCommand := FALSE;
        eState := E_MachineState.HELD;

    E_MachineState.HELD:
        IF bCmdStart AND bSafetyOk THEN
            bCmdStart := FALSE;
            eState := E_MachineState.UNHOLDING;
        END_IF

    E_MachineState.UNHOLDING:
        eState := E_MachineState.EXECUTE;

    // ---------------------------------------------------------
    // FAULTS & SAFETY 
    // ---------------------------------------------------------
    E_MachineState.ABORTING:
        // Drop logical commands
        RotaryKnife.bSyncCommand := FALSE;
        
        // PHASE 2 FIX: Active braking for process faults (e.g., Jam)
        // If safety is still OK, we use servo torque to brake rather than coasting
        IF bSafetyOk THEN
            ConveyorMotor.M_Stop();
            KnifeMotor.M_Stop();
        END_IF
        
        eState := E_MachineState.ABORTED;

    E_MachineState.ABORTED:
        // Wait for physical safety to return AND operator to press Reset
        IF bSafetyOk AND bCmdReset THEN
            bCmdReset := FALSE;
            eState := E_MachineState.CLEARING;
        END_IF

    E_MachineState.CLEARING:
        // Require explicit Acknowledge (Confirm) before clearing
        fbAlarmJam.Confirm(0);
        fbAlarmJam.Clear(0, TRUE);
        
        fbAlarmSafety.Confirm(0);
        fbAlarmSafety.Clear(0, TRUE);
        
        // PHASE 1 FIX: Clear physical NC Axis faults before restarting
        ConveyorMotor.M_Reset();
        KnifeMotor.M_Reset();
        
        eState := E_MachineState.STOPPED;

    // ---------------------------------------------------------
    // AUXILIARY MODES
    // ---------------------------------------------------------
    E_MachineState.CLEANING:
        IF bCmdStop THEN
            bCmdStop := FALSE;
            eState := E_MachineState.STOPPED;
        END_IF

END_CASE

// =========================================================
// 3. INDUSTRIAL DIAGNOSTICS (ALARM LOGIC)
// =========================================================
IF NOT bAlarmsInitialized THEN
    fbAlarmJam.CreateEx(TC_Events.MachineAlarms.ConveyorSensorJam, TRUE, 0);
    fbAlarmSafety.CreateEx(TC_Events.MachineAlarms.SafetyTrip, TRUE, 0); 
    bAlarmsInitialized := TRUE;
END_IF

// --- Jam Detection ---
tonSensorJam(IN := (fbProductSensor.bRawInput AND eState = E_MachineState.EXECUTE), PT := T#5S);

IF tonSensorJam.Q THEN
    fbAlarmJam.Raise(0);
    eState := E_MachineState.ABORTING; 
END_IF

// =========================================================
// 4. HARDWARE SAFETY MASK & DRIVE POWER
// =========================================================
IF bSafetyOk THEN
    // Provide power/enable to the servo drives
    ConveyorMotor.bEnableCmd := TRUE;
    KnifeMotor.bEnableCmd    := TRUE;
ELSE
    // Drop power and logical commands immediately if safety is breached
    ConveyorMotor.bEnableCmd := FALSE;
    KnifeMotor.bEnableCmd    := FALSE;
    
    RotaryKnife.bEnable      := FALSE;
    RotaryKnife.bSyncCommand := FALSE;
    InfeedConveyor.bEnable   := FALSE; 
END_IF

// =========================================================
// 5. ALWAYS CALL THE MODULES AND MOTORS
// =========================================================
fbProductSensor();

// Pass the global references into the VAR_IN_OUT variables here:
ConveyorMotor(Axis := GVL_Motion.stConveyorAxis);
KnifeMotor(Axis := GVL_Motion.stKnifeAxis);

InfeedConveyor();

RotaryKnife(
    MasterAxis := GVL_Motion.stConveyorAxis,
    SlaveAxis  := GVL_Motion.stKnifeAxis
);
// =========================================================
// 6. TELEMETRY & CLOUD SYNC
// =========================================================
EdgeGateway(
    eCurrentState := eState,
    udiCutsCompleted := udiCutsCompleted
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>