<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_RotaryKnife" Id="{48fb6193-f953-456c-9937-b4916335cb68}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_RotaryKnife
VAR_IN_OUT
    // --- Strict Compile-Time Hardware Bindings ---
    MasterAxis : AXIS_REF;
    SlaveAxis  : AXIS_REF;
END_VAR
VAR_INPUT
    iMotor          : I_Drive;
    bEnable         : BOOL;
    bEngageGearing  : BOOL; 
    
    {attribute 'TcLinkTo' := '1'}
    bSyncCommand AT %Q* : BOOL;
    
    bHomeCommand    : BOOL;  
    fKnifeDiameter  : LREAL := 100.0; 
END_VAR
VAR
    fbGearIn        : MC_GearIn;
    fbGearOut       : MC_GearOut;
    rtHome          : R_TRIG; 
    
    bIsSynchronized : BOOL;
    bError          : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 1. Safety Check: Only run if a motor has been assigned
IF iMotor <> 0 THEN
    
    // 2. Control the Motor Power
    iMotor.P_Enabled := bEnable;
    bError := iMotor.P_Error;

    // =========================================================
    // 3. HOMING SEQUENCE
    // =========================================================
    rtHome(CLK := bHomeCommand);
    IF rtHome.Q THEN
        iMotor.M_Home(); 
    END_IF

    // =========================================================
    // 4. ELECTRONIC GEARING (Synchronization)
    // =========================================================
    // Command to Lock the Knife to the Conveyor
    fbGearIn(
        Master           := MasterAxis,
        Slave            := SlaveAxis, 
        Execute          := bEngageGearing, 
        RatioNumerator   := 1,
        RatioDenominator := 1,
        Acceleration     := 10000,
        Deceleration     := 10000
    );
    
    bIsSynchronized := fbGearIn.InGear;
    
    // Command to Unlock (Stop following)
    fbGearOut(
        Slave            := SlaveAxis,
        Execute          := NOT bEngageGearing AND bIsSynchronized 
    );
    
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>